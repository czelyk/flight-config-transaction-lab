# Optional native Windows CMake path. Python runner does not need this file.
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ZIG_EXECUTABLE)
if(NOT ZIG_EXECUTABLE)
    message(FATAL_ERROR "Pass -DZIG_EXECUTABLE=<path/to/zig.exe>")
endif()
set(CMAKE_C_COMPILER "${ZIG_EXECUTABLE}" CACHE FILEPATH "C compiler")
set(CMAKE_C_COMPILER_ARG1 "cc" CACHE STRING "Zig C driver")
set(CMAKE_AR "${ZIG_EXECUTABLE}" CACHE FILEPATH "Archive tool")
set(CMAKE_C_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_C_ARCHIVE_APPEND "<CMAKE_AR> ar q <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_C_ARCHIVE_FINISH "")
